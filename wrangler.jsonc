{
  "name": "cuartango-web",
  "main": "worker.js",
  "compatibility_date": "2025-09-01",
  "routes": [
    { "pattern": "cuartango.com", "custom_domain": true },
    { "pattern": "www.cuartango.com", "custom_domain": true }
  ],
  "assets": { "directory": "./", "binding": "ASSETS", "run_worker_first": true },
  "vars": {
    "CONTACT_TO": "info@cuartango.com",
    "MAIL_FROM": "Cuartango Web <web@cuartango.com>"
  }
}
